DATABASE_URL=sqlite+aiosqlite:///./sih165.db
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Stage 1 model paths (populated after training)
STAGE1_TFIDF_PATH=../ml/models/stage1_tfidf.pkl
STAGE1_LOGREG_PATH=../ml/models/stage1_logreg.pkl

# Stage 2 model paths (populated after training)
STAGE2_TRANSFORMER_PATH=../ml/models/stage2_transformer
STAGE2_XGB_PATH=../ml/models/stage2_xgb.pkl
STAGE2_CALIBRATION_PATH=../ml/models/stage2_platt.pkl
STAGE2_OOD_PATH=../ml/models/stage2_ood.pkl

# OCR confidence threshold (below this → manual review)
OCR_CONFIDENCE_THRESHOLD=0.6

# OOD Mahalanobis threshold (above this → manual review)
OOD_THRESHOLD=3.5

# Recall floor policy
RECALL_FLOOR=0.90

# Deployed environment
ENVIRONMENT=development
